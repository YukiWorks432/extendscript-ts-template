{
  "compilerOptions": {
    "target": "ES3",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES5", "ES2015.Core", "ES2015.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "ignoreDeprecations": "5.0",
    "types": [
      "./node_modules/types-for-adobe/shared/global",
      "./node_modules/types-for-adobe/shared/PlugPlugExternalObject",
      "./node_modules/types-for-adobe/shared/ScriptUI"
    ]
  },
  "include": [
    "src/lib/**/*",
    "src/types/**/*",
    "src/init.ts",
    "src/tests/**/*",
    "src/*/index.ts"
  ]
}
